# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SITE_URL: Your production canonical domain (e.g. https://www.global24x7.in)
# If set in Render/hosting dashboard, sitemaps and RSS feeds use this domain.
SITE_URL="https://www.global24x7.in"

# ADMIN_PASSCODE: Master editorial passcode for the admin suite.
# Configure this in Render Environment Variables to guarantee permanent passcode persistence across server redeploys.
ADMIN_PASSCODE=""

# ADSENSE_ENABLED: Enable or disable AdSense globally ("true" or "false")
ADSENSE_ENABLED="false"
ADSENSE_PUBLISHER_ID=""

# SESSION_SECRET: Secret key for signing admin authentication tokens
SESSION_SECRET="global24x7-prod-session-key-2026-v1"

# CLOUDFLARE D1 DATABASE INTEGRATION:
# Set these in your Render Dashboard to automatically sync articles and site settings to Cloudflare D1 SQL database
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""

